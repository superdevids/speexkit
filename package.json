  "sideEffects": false,
  "files": [
    "dist",
    "*.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "biome check src/",
    "lint:fix": "biome check --write src/",
    "typecheck": "tsc --noEmit",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "size": "size-limit",
    "bench": "vitest bench",
    "ci": "npm run lint && npm run typecheck && npm run build && npm run test:coverage"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.1",
    "@size-limit/file": "^11.0.0",
    "@types/node": "^26.0.1",
    "@vitest/coverage-v8": "^2.1.9",
    "size-limit": "^11.0.0",
    "tsup": "^8.3.0",
    "typescript": "^5.7.0",
    "vite": "^8.1.0",
    "vitest": "^2.1.9"
  },
  "size-limit": [
    {
      "path": "dist/index.js",
      "limit": "500 KB"
    }
  ],
